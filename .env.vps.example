# Copy to .env on the VPS. Keep the real .env out of Git.
DEBUG=false
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=demo.example.com
CSRF_TRUSTED_ORIGINS=https://demo.example.com
SECURE_SSL_REDIRECT=true
BEHIND_HTTPS_PROXY=true

POSTGRES_DB=zain_store
POSTGRES_USER=zain_store
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=zain-store-db
POSTGRES_PORT=5432
DB_ENGINE=django.db.backends.postgresql

# Test-mode credentials only for this demo.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
